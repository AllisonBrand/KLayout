 <dsl-interpreter-name/>
 <text>import pya
import traceback

import Sweep

# Example PCells to sweep:
#    Will be added to SweepLib.
#    PCells do not need to be defined in any particular library to be wrapped, 
#    defining them here is just convenient for this example.
from testing.HEMT import HEMT
from testing.CircularHEMT import CircularHEMT

class SweepLib(pya.Library):
    def __init__(self):
        try:
          self.description = "Library for parameter sweep PCells"
          self.layout().register_pcell('HEMT',         HEMT()) 
          self.layout().register_pcell('CircularHEMT', CircularHEMT()) 
          self.register('SweepLib') # If a library with that name already existed, it will be replaced now.
        except Exception as e:
          print(f'SweepLib __init__ error: \n{traceback.format_exc()}') 


# Create library
lib = SweepLib()

# Use wrapper PCell Sweep:
src_lib_name = "SweepLib" # Library where the PCell to wrap is defined.
try: 
  sweep_HEMT = Sweep.custom_sweep_pcell('HEMT', src_lib_name)
  lib.layout().register_pcell('HEMT_ParamSweep', sweep_HEMT())
  
  sweep_CircularHEMT = Sweep.custom_sweep_pcell('CircularHEMT', src_lib_name)
  lib.layout().register_pcell('CircularHEMT_ParamSweep', sweep_CircularHEMT())
  
except Exception as e:
  print(f'custom_sweep_pcell error: \n{traceback.format_exc()}')

# Now we have a library SweepLib containing HEMT_ParamSweep, CircularHEMT_ParamSweep, HEMT, and CircularHEMT!

    </text>
</klayout-macro>
